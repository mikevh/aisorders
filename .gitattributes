# Normalize to LF in the repository; check out LF everywhere by default.
* text=auto eol=lf

# Windows-native tooling that prefers CRLF on disk.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
*.sln  text eol=crlf

# Never munge these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
